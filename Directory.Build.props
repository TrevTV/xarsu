<Project>
    <PropertyGroup>
        <Version>0.0.1</Version>

        <Authors>trev</Authors>
        <Copyright>Copyright (c) 2025 trev.app</Copyright>
		<Description>NativeAOT-based Unity mod loader for Il2CPP</Description>

        <LangVersion>Latest</LangVersion>
        <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    </PropertyGroup>

    <PropertyGroup Condition="'$(RuntimeIdentifier.StartsWith(`linux-bionic`))' == 'true'">
        <RuntimeIdentifiers>linux-bionic-arm64</RuntimeIdentifiers>
        <RuntimeIdentifier>linux-bionic-arm64</RuntimeIdentifier>
        <PlatformTarget>arm64</PlatformTarget>
        <DefineConstants>$(DefineConstants);ANDROID</DefineConstants>
        <LibPrefix>lib</LibPrefix>
        <LibExt>.a</LibExt>
    </PropertyGroup>

    <PropertyGroup Condition="'$(RuntimeIdentifier.StartsWith(`win-x64`))' == 'true'">
        <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
        <RuntimeIdentifier>win-x64</RuntimeIdentifier>
        <PlatformTarget>x64</PlatformTarget>
        <DefineConstants>$(DefineConstants);WINDOWS</DefineConstants>
        <LibPrefix></LibPrefix>
        <LibExt>.lib</LibExt>
    </PropertyGroup>
</Project>
